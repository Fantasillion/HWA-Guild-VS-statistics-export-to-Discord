        help.textContent =
            'Open Guild VS rankings, your own ' +
            'guild members, and the opposing ' +
            'guild member list. No new game ' +
            'API requests are sent.';

        help.style.cssText =
            'font-size:11px;line-height:1.4;' +
            'color:#aebdce;';

        body.append(
            indicators,
            preview,
            buttons,
            feedback,
            help
        );

        panel.append(
            header,
            body
        );

        doc.body.appendChild(panel);

        let collapsed = false;

        minimize.addEventListener(
            'click',
            () => {
                collapsed = !collapsed;

                body.style.display =
                    collapsed ? 'none' : 'flex';

                minimize.textContent =
                    collapsed ? '+' : '−';
            }
        );

        render();
        logger('Floating panel mounted');
    }

    // --------------------------------------------------------
    // AUTOMATIC PANEL RECOVERY
    // --------------------------------------------------------

    function ensurePanel() {
        try {
            if (
                panel &&
                panel.isConnected
            ) {
                return;
            }

            panel = null;
            mount();

        } catch (error) {
            console.error(
                '[Guild VS] Panel error',
                error
            );
        }
    }

    page.document.addEventListener(
        'DOMContentLoaded',
        ensurePanel,
        { once: true }
    );

    page.addEventListener(
        'load',
        ensurePanel,
        { once: true }
    );

    page.setInterval(
        ensurePanel,
        3000
    );

    ensurePanel();

    logger(
        'Weekly Reporter v1.2 initialized'
    );
})();
